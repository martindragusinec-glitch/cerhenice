{
  "cleanUrls": true,
  "headers": [
    { "source": "/assets/:dir(img|video|brand)/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/:dir(js|css|data)/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
