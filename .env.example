# Proměnné prostředí pro Vercel (Settings → Environment Variables).
# Heslo do administrace /admin. Dlouhé a náhodné, nikam ho nepište do kódu.
ADMIN_PASSWORD=
# Tajný klíč pro podpis přihlášení (náhodný řetězec, např. 40 znaků).
SESSION_SECRET=
# Úložiště: přidejte ve Vercelu integraci Upstash for Redis (Storage → Upstash), proměnné se doplní samy:
# KV_REST_API_URL=  KV_REST_API_TOKEN=   (nebo UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# Volitelně e-mail o nové poptávce přes Resend (resend.com):
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Za Kapličkou <poptavky@zakaplickou.cz>
# Lokálně (node tools/serve.cjs) se použije souborové úložiště .data/store.json a heslo LOCAL_ADMIN_PASSWORD ze souboru .env.local (není v gitu).
